{
  "meta": {
    "title": "Deep Search Challenge",
    "tagline": "An interactive AI agent workflow simulation",
    "version": "1.0.0"
  },

  "settings": {
    "defaultTeams": 4,
    "maxPlayersPerTeam": 4,
    "defaultDurationMinutes": 5,
    "cardsPerStage": 12,
    "scoring": {
      "pointsPerStage": 25,
      "wrongSelectionPenaltyWeight": 0.75,
      "orderedStages": ["planner", "reporter"],
      "maxTimeBonus": 10,
      "maxScore": 100,
      "stars": [
        { "min": 90, "stars": 3 },
        { "min": 70, "stars": 2 },
        { "min": 45, "stars": 1 },
        { "min": 0, "stars": 0 }
      ]
    }
  },

  "roles": [
    {
      "id": "planner",
      "order": 1,
      "name": "Planner Agent",
      "icon": "🧭",
      "avatar": "🤖",
      "description": "The strategist of the swarm. Turns a vague human question into an executable research strategy.",
      "goal": "Break the research problem into a logical search strategy.",
      "mission": "Select the steps that form the strongest possible search plan.",
      "input": "Research Question",
      "output": "Search Plan",
      "quote": "I don't Google. I Google what should be Googled.",
      "loadingMessage": "Thinking before searching...",
      "funMessages": [
        "Drawing arrows between boxes...",
        "Refusing to search until the plan is beautiful.",
        "Strategy first. Panic later."
      ]
    },
    {
      "id": "searcher",
      "order": 2,
      "name": "Searcher Agent",
      "icon": "🔎",
      "avatar": "🛰️",
      "description": "The field operative. Executes the plan across the open web and pulls back raw sources.",
      "goal": "Retrieve the highest quality sources that satisfy the plan.",
      "mission": "Pick the sources a serious researcher would actually open.",
      "input": "Search Plan",
      "output": "Collected Sources",
      "quote": "Searching the internet... definitely not opening Reddit first.",
      "loadingMessage": "Crawling the open web...",
      "funMessages": [
        "Opening 47 tabs. Closing 46.",
        "Page 2 of the results exists. I checked.",
        "Ignoring the sponsored links like a professional."
      ]
    },
    {
      "id": "validator",
      "order": 3,
      "name": "Validator Agent",
      "icon": "🛡️",
      "avatar": "⚖️",
      "description": "The skeptic. Assumes every source is guilty of being wrong until proven otherwise.",
      "goal": "Filter the collected sources down to what can actually be trusted.",
      "mission": "Apply the validation checks that matter for this question.",
      "input": "Collected Sources",
      "output": "Validated Evidence",
      "quote": "Trust... but verify. Mostly verify.",
      "loadingMessage": "Cross-examining the evidence...",
      "funMessages": [
        "This blog post is not a peer-reviewed journal.",
        "Checking the date. Always checking the date.",
        "Confidence is not a citation."
      ]
    },
    {
      "id": "reporter",
      "order": 4,
      "name": "Reporter Agent",
      "icon": "📝",
      "avatar": "📊",
      "description": "The closer. Assembles validated evidence into something a human will actually read.",
      "goal": "Structure the findings into a clear, defensible report.",
      "mission": "Choose the right sections and put them in the right order.",
      "input": "Validated Evidence",
      "output": "Final Report",
      "quote": "Turning chaos into PowerPoint since 2023.",
      "loadingMessage": "Assembling the final report...",
      "funMessages": [
        "Executive summary: it depends.",
        "Adding a chart nobody asked for.",
        "Making the conclusion sound inevitable."
      ]
    }
  ],

  "plannerSteps": [
    { "id": "p_topic", "label": "Identify the core topic", "hint": "Define exactly what is being asked" },
    { "id": "p_questions", "label": "Break into sub-questions", "hint": "Decompose before searching" },
    { "id": "p_authoritative", "label": "Find authoritative sources", "hint": "Prefer primary and institutional sources" },
    { "id": "p_viewpoints", "label": "Compare opposing viewpoints", "hint": "Balance the argument" },
    { "id": "p_recency", "label": "Check recency of information", "hint": "Is this still true today?" },
    { "id": "p_evidence", "label": "Verify evidence behind claims", "hint": "Claim without data is opinion" },
    { "id": "p_primary", "label": "Locate primary sources", "hint": "Go to the original document" },
    { "id": "p_crosscheck", "label": "Cross-check facts across sources", "hint": "Two independent confirmations" },
    { "id": "p_bias", "label": "Note conflicts of interest", "hint": "Who benefits from this claim?" },
    { "id": "p_timeframe", "label": "Scope the timeframe", "hint": "Bound the period under study" },
    { "id": "p_quant", "label": "Collect quantitative data", "hint": "Numbers beat adjectives" },
    { "id": "p_official", "label": "Review official statements and records", "hint": "Straight from the institution" },
    { "id": "p_experts", "label": "Consult domain experts", "hint": "People who do this for a living" },
    { "id": "p_legal", "label": "Read the regulatory or legal text", "hint": "The law says what it says" },
    { "id": "p_context", "label": "Establish historical context", "hint": "How did we get here?" },
    { "id": "p_summarize", "label": "Summarize findings neutrally", "hint": "Report, don't campaign" },
    { "id": "p_reddit_only", "label": "Search Reddit only", "hint": "", "trap": true },
    { "id": "p_ignore_dates", "label": "Ignore dates entirely", "hint": "", "trap": true },
    { "id": "p_random_blogs", "label": "Use random blogs as the main source", "hint": "", "trap": true },
    { "id": "p_first_result", "label": "Trust the first search result", "hint": "", "trap": true },
    { "id": "p_agree_only", "label": "Keep only sources that agree with me", "hint": "", "trap": true },
    { "id": "p_skip_verify", "label": "Skip verification to save time", "hint": "", "trap": true },
    { "id": "p_ask_friend", "label": "Ask a friend on WhatsApp", "hint": "", "trap": true },
    { "id": "p_yt_comments", "label": "Read the YouTube comments", "hint": "", "trap": true }
  ],

